{
  "name": "@dino/standards",
  "version": "1.1.0",
  "description": "Shared agent rules, design vocabulary, and lint configs for Dino projects",
  "type": "module",
  "packageManager": "bun",
  "bin": {
    "standards": "src/cli.ts"
  },
  "files": [
    "agents",
    "design",
    "configs",
    "src",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "echo \"@dino/standards has no dev server\"",
    "build": "echo \"@dino/standards ships TypeScript source\"",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src && bun src/checkNoComments.ts && knip",
    "format": "oxfmt src agents design configs README.md",
    "format:check": "oxfmt --check src agents design configs README.md",
    "knip": "knip",
    "audit": "bun audit --audit-level=high",
    "check": "bun run lint && bun run typecheck && bun run test && bun run format:check && bun run audit && bun src/cli.ts check"
  },
  "dependencies": {
    "oxc-parser": "^0.151.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "knip": "^6.31.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "npm:@typescript/native-preview@7.0.0-dev.20260707.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "typescript": "npm:@typescript/native-preview@7.0.0-dev.20260707.2"
  }
}
